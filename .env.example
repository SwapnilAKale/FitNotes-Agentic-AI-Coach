# FitNotes Personal Coach — Environment Variables
# Get your free Gemini API key at: https://aistudio.google.com

GEMINI_API_KEY=your_gemini_key_here

# Web search for mapping new exercises (scripts/review_pending.py --propose).
# Free key, 1,000 searches a month, no card: https://app.tavily.com
TAVILY_API_KEY=your_tavily_key_here
HF_HUB_DISABLE_IMPLICIT_TOKEN_WARNING=1

# Optional — override default paths
# CHROMA_DB_PATH=./data/chroma_db

# Optional — local behaviour switch (defaults to 1 when unset)
# OPEN_BROWSER=0     # don't open a browser tab on start

# ── Docker / public demo (docker-compose.yml; see DEPLOY.md) ────────────────
# Hostname Caddy gets a certificate for. No domain? Use your VM's public IP
# with dashes + .sslip.io, e.g. 203-0-113-7.sslip.io
# DOMAIN=203-0-113-7.sslip.io
# DEMO_MODE=1                      # synthetic data; uploads/settings off; rate limits
# DEMO_RESET_ON_START=1            # fresh synthetic demo data on every container start (visitors' chats are kept)
# DEMO_RATE_LIMIT_PER_MINUTE=3     # questions per visitor IP per minute
# DEMO_RATE_LIMIT_PER_DAY=30       # questions per visitor IP per day
# DEMO_RATE_LIMIT_GLOBAL_PER_DAY=0 # questions for ALL visitors per day (0 = no cap)
# Each visitor (browser) has a private conversation, stored on the data volume
# in data/visitor_sessions/sessions.sqlite.
# DEMO_SESSION_TTL_DAYS=30         # delete a visitor's chat after N days without a question
# DEMO_MAX_SESSIONS=5000           # most chats kept; the least recently used are evicted
# DEMO_SESSIONS_MAX_MB=200         # most disk all chats may use; same eviction
# DEMO_SESSION_MAX_KB=256          # one chat's size; its oldest messages are trimmed past it
# DEMO_MAX_QUEUED_TURNS=4          # questions that may wait behind the one being answered
# Optional password for the whole site (user name APP_USER, default "demo").
# Hash it with: docker run --rm caddy:2-alpine caddy hash-password -p 'secret'
# Keep the single quotes — the hash contains $ signs.
# APP_PASSWORD_HASH='$2a$14$...'
